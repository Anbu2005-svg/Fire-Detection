# Backend server settings
HOST=127.0.0.1
PORT=5000
SERVER_PUBLIC_URL=http://127.0.0.1:5000

# Supabase frontend login and backend API protection
# Frontend values are read by Vite from this root .env file.
VITE_AUTH_REQUIRED=true
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend values are read by Flask from this same root .env file.
# Find the JWT secret in:
# Supabase dashboard -> Project Settings -> API -> JWT Settings.
SUPABASE_AUTH_REQUIRED=1
SUPABASE_JWT_SECRET=

# Free server-side alerts
# Telegram is the recommended free channel. Create a bot with @BotFather,
# send the bot one message, then use getUpdates to find your chat id.
NOTIFICATION_ENABLED=1
NOTIFICATION_CHANNELS=telegram
NOTIFICATION_COOLDOWN_SECONDS=120
NOTIFICATION_MIN_CONFIDENCE=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional generic webhook alert receiver
# Use NOTIFICATION_CHANNELS=telegram,webhook to send both.
WEBHOOK_URL=
